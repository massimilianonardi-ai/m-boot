# Locate an external m-loader while retaining an embedded recovery path.
export root
export prefix

export init_disk
export boot_disk

export m_loader_disk
export m_loader_dir
export m_loader_init

set root="memdisk"
set prefix="($root)"

set init_disk="$root"
set m_loader_recovery="($init_disk)/recovery"

set boot_disk=""

set m_loader_disk=""
set m_loader_dir="/m/boot/loader"
set m_loader_init="$m_loader_dir/init"

if [ -n "$cmdpath" ]
then
  if regexp --set boot_disk '^\(([^)]*)\)' "$cmdpath"
  then
    echo "m-boot: firmware boot device ($boot_disk)"
  else
    echo "m-boot: cannot identify boot device from cmdpath='$cmdpath'"
  fi
fi

# Prefer the firmware boot disk only when it contains our external loader.
if [ -n "$boot_disk" ]
then
  if [ -f "($boot_disk)$m_loader_init" ]
  then
    set m_loader_disk="$boot_disk"
  fi
fi

if [ -z "$m_loader_disk" ]
then
  echo "m-boot: m-loader not found on firmware boot device, searching all devices..."
  if search --no-floppy --file --set m_loader_disk "$m_loader_init"
  then
    echo "m-boot: found m-loader on disk=($m_loader_disk), path='$m_loader_init'"
  else
    echo "m-boot: m-loader cannot be found."
    set m_loader_disk=""
  fi
fi

if [ -n "$m_loader_disk" ]
then
  if [ -f "($m_loader_disk)$m_loader_init" ]
  then
    set root="$m_loader_disk"
    echo "m-boot: executing m-loader on disk=($m_loader_disk), path='$m_loader_init'"
    if source "$m_loader_init"
    then
      echo "m-boot: m-loader script loaded."
    else
      echo "m-boot: m-loader execution error."
      set m_loader_disk=""
    fi
  else
    echo "m-boot: selected m-loader is no longer accessible."
    set m_loader_disk=""
  fi
fi

if [ -z "$m_loader_disk" ]
then
  echo "m-boot: executing embedded recovery..."
  set root="$init_disk"
  set prefix="($init_disk)"
  source "$m_loader_recovery"
fi
