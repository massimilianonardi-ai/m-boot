# User-facing external media index. The ESP owns this script; exFAT owns payloads.
set default=0
set timeout=-1

# GRUB loads filesystem support from the already selected ESP loader prefix.
insmod part_gpt
insmod exfat

# Prefer the data volume label, but also allow a different label when the
# operator's existing /m/boot/iso directory can be discovered unambiguously.
set boot_media_device=""
if search --no-floppy --label --set=boot_media_device MBOOTDATA
then
  if [ ! -d "($boot_media_device)/m/boot/iso" ]
  then
    set boot_media_device=""
  fi
fi
if [ -z "$boot_media_device" ]
then
  for boot_media_candidate in (*)
  do
    if [ -d "$boot_media_candidate/m/boot/iso" ]
    then
      regexp --set=boot_media_device '^\(([^)]*)\) "$boot_media_candidate"
      break
    fi
  done
fi

if [ -z "$boot_media_device" ]
then
  menuentry "No external boot media found" {
    echo "No /m/boot/iso directory is accessible on external filesystems."
    echo "Check the exFAT MBOOTDATA partition and GRUB filesystem support."
    sleep --interruptible 30
  }
else
  # Make the ISO paths Linux-initramfs friendly: absolute paths *within*
  # the exFAT filesystem, not GRUB "(hdX,gptY)/..." device-qualified paths.
  set root="$boot_media_device"
  set isopath="/m/boot/iso"
  set efipath="/m/boot/efi"
  export isopath efipath

  submenu "Recovery and backup" {
    source "$prefix/menu/boot-media-recovery"
  }
  submenu "Live systems and installers" {
    source "$prefix/menu/boot-media-install"
  }
  submenu "Hardware diagnostics" {
    source "$prefix/menu/boot-media-diagnostics"
  }
  submenu "Network boot" {
    source "$prefix/menu/boot-media-network"
  }
fi
