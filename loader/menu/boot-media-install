# Architecture-specific live systems and installers on MBOOTDATA.
# The experimental route tries the ISO's own GRUB menu or EFI loader.
for image in "$isopath"/ubuntu-*-desktop-*.iso
do
  if [ -f "$image" ]
  then
    if [ "$grub_cpu" = arm64 ]
    then
      if regexp -- '-arm64[.]iso$' "$image"
      then
        boot_media_iso_experimental "$image" "$image"
      fi
    else
      if regexp -- '-amd64[.]iso$' "$image"
      then
        boot_media_iso_experimental "$image" "$image"
      fi
    fi
  fi
done

for image in "$isopath"/proxmox-ve_*.iso
do
  if [ -f "$image" ]
  then
    if [ "$grub_cpu" = arm64 ]
    then
      if regexp -- '-arm64[.]iso$' "$image"
      then
        boot_media_iso_experimental "$image" "$image"
      fi
    else
      if regexp -- '-arm64[.]iso$' "$image"
      then
        echo "Skipping ARM64 Proxmox ISO on x86_64."
      else
        boot_media_iso_experimental "$image" "$image"
      fi
    fi
  fi
done

if [ "$grub_cpu" != arm64 ]
then
  for image in "$isopath"/proxmox-backup-server_*.iso \
    "$isopath"/TrueNAS-SCALE-*.iso \
    "$isopath"/OPNsense-*-amd64.iso
  do
    if [ -f "$image" ]
    then
      boot_media_iso_experimental "$image" "$image"
    fi
  done
fi

# .iso.bz2 is a compressed archive, not a bootable ISO. Use its .iso.
