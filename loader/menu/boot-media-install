# Live installers available as regular files on the ext4 payload volume.
# Architecture-filtered Ubuntu and Proxmox menus avoid misleading cross-CPU choices.
for image in "$isopath"/ubuntu-*-desktop-*.iso
do
  if [ -f "$image" ]
  then
    if [ "$grub_cpu" = arm64 ]
    then
      if regexp -- '-arm64\.iso$' "$image"
      then
        boot_media_iso_experimental "$image" "$image"
      fi
    else
      if regexp -- '-amd64\.iso$' "$image"
      then
        boot_media_iso_experimental "$image" "$image"
      fi
    fi
  fi
done

