# Architecture-specific live systems and installers on MBOOTDATA.
# The experimental route tries the ISO's own GRUB menu or EFI loader.

# Kali live uses Debian live-boot; findiso= identifies the ISO on ext4
# after GRUB hands off to the kernel. Forensic mode adds Kali's published
# noswap/noautomount parameters; persistence is deliberately not enabled.
function boot_media_kali_live {
  if boot_media_iso_open "$1"
  then
    if [ -f "(loop)/live/vmlinuz" ]
    then
      if [ -f "(loop)/live/initrd.img" ]
      then
        echo "Starting Kali Linux Live from $iso_path"
        if [ "$2" = forensic ]
        then
          linux (loop)/live/vmlinuz boot=live components findiso="$iso_path" noswap noautomount
        else
          linux (loop)/live/vmlinuz boot=live components findiso="$iso_path"
        fi
        initrd (loop)/live/initrd.img
      else
        echo "Kali Live ISO does not contain /live/initrd.img."
        echo "Inspect this image before selecting a different boot recipe."
        sleep --interruptible 30
      fi
    else
      echo "Kali Live ISO does not contain /live/vmlinuz."
      echo "Expected a Live image, not an Installer image."
      sleep --interruptible 30
    fi
    boot_media_iso_close
  else
    sleep --interruptible 30
  fi
}

# Only offer Kali images matching GRUB's active architecture.
if [ "$grub_cpu" = arm64 ]
then
  for image in "$isopath"/kali-linux-*-live-arm64.iso
  do
    if [ -f "$image" ]
    then
      submenu "$image (Kali Live ARM64) ->" "$image" {
        set selected_iso="$2"
        export selected_iso
        menuentry "Kali Linux Live (no persistence)" {
          boot_media_kali_live "$selected_iso" normal
        }
        menuentry "Kali Linux Live (forensic: no swap/automount)" {
          boot_media_kali_live "$selected_iso" forensic
        }
        menuentry "Inspect Kali ISO files" {
          boot_media_iso_inspect "$selected_iso"
        }
      }
    fi
  done
else
  for image in "$isopath"/kali-linux-*-live-amd64.iso
  do
    if [ -f "$image" ]
    then
      submenu "$image (Kali Live AMD64) ->" "$image" {
        set selected_iso="$2"
        export selected_iso
        menuentry "Kali Linux Live (no persistence)" {
          boot_media_kali_live "$selected_iso" normal
        }
        menuentry "Kali Linux Live (forensic: no swap/automount)" {
          boot_media_kali_live "$selected_iso" forensic
        }
        menuentry "Inspect Kali ISO files" {
          boot_media_iso_inspect "$selected_iso"
        }
      }
    fi
  done
fi

for image in "$isopath"/ubuntu-*-desktop-*.iso
do
  if [ -f "$image" ]
  then
    if [ "$grub_cpu" = arm64 ]
    then
      if regexp -- '-arm64[.]iso$' "$image"
      then
        boot_media_iso_experimental "$image" "$image"
      fi
    else
      if regexp -- '-amd64[.]iso$' "$image"
      then
        boot_media_iso_experimental "$image" "$image"
      fi
    fi
  fi
done

for image in "$isopath"/proxmox-ve_*.iso
do
  if [ -f "$image" ]
  then
    if [ "$grub_cpu" = arm64 ]
    then
      if regexp -- '-arm64[.]iso$' "$image"
      then
        boot_media_iso_experimental "$image" "$image"
      fi
    else
      if regexp -- '-arm64[.]iso$' "$image"
      then
        echo "Skipping ARM64 Proxmox ISO on x86_64."
      else
        boot_media_iso_experimental "$image" "$image"
      fi
    fi
  fi
done

if [ "$grub_cpu" != arm64 ]
then
  for image in "$isopath"/proxmox-backup-server_*.iso \
    "$isopath"/OPNsense-*-amd64.iso
  do
    if [ -f "$image" ]
    then
      boot_media_iso_experimental "$image" "$image"
    fi
  done

  for image in "$isopath"/TrueNAS-SCALE-*.iso
  do
    if [ -f "$image" ]
    then
      boot_media_iso_experimental "$image" "$image"
      # Debian live-boot can locate an ISO file by findiso=; current
      # TrueNAS installer additionally needs its installation medium.
      # This test intentionally does not claim /cdrom will be available.
      menuentry "$image (live-boot findiso experiment)" "$image" {
        if boot_media_iso_open "$2"
        then
          if [ -f "(loop)/vmlinuz" ]
          then
            if [ -f "(loop)/initrd.img" ]
            then
              echo "Experimental TrueNAS live-boot ISO search: $iso_path"
              echo "A usable installer still requires installation media."
              linux (loop)/vmlinuz gfxpayload=text quiet nomodeset boot=live toram=filesystem.squashfs findiso="$iso_path" console=tty0
              initrd (loop)/initrd.img
            else
              echo "TrueNAS ISO has no root initrd.img."
              sleep --interruptible 30
            fi
          else
            echo "TrueNAS ISO has no root vmlinuz."
            sleep --interruptible 30
          fi
          boot_media_iso_close
        else
          sleep --interruptible 30
        fi
      }
    fi
  done
fi

# .iso.bz2 is a compressed archive, not a bootable ISO. Use its .iso.
