# Prefer a matching native iPXE image: the ISO is only a CD/DVD transport.
# EFI applications on ext4 may be rejected by specific firmware: test results
# belong to the selected architecture, not to a generic "netboot works" claim.
if [ "$grub_platform" = efi ]
then
  if [ "$grub_cpu" = x86_64 ]
  then
    for image in "$efipath"/netboot/netboot.xyz.efi \
      "$efipath"/netboot/netboot.xyz-snp.efi \
      "$efipath"/netboot/netboot.xyz-snponly.efi
    do
      if [ -f "$image" ]
      then
        menuentry "$image (UEFI chainload, experimental)" "$image" {
          chainloader "$2"
          boot
        }
      fi
    done
  fi
  if [ "$grub_cpu" = arm64 ]
  then
    for image in "$efipath"/netboot/netboot.xyz-arm64.efi \
      "$efipath"/netboot/netboot.xyz-arm64-snp.efi \
      "$efipath"/netboot/netboot.xyz-arm64-snponly.efi
    do
      if [ -f "$image" ]
      then
        menuentry "$image (UEFI chainload, experimental)" "$image" {
          chainloader "$2"
          boot
        }
      fi
    done
  fi
fi

# The copied multiarch ISO can be inspected and its embedded EFI application
# attempted on UEFI; standard GRUB does not provide BIOS ISO-emulation here.
for image in "$isopath"/netboot.xyz-*.iso
do
  if [ -f "$image" ]
  then
    boot_media_iso_experimental "$image" "$image"
  fi
done

if [ "$grub_platform" = pc ]
then
  for image in "$efipath"/netboot/*.lkrn
  do
    if [ -f "$image" ]
    then
      menuentry "$image (BIOS iPXE kernel)" "$image" {
        linux16 "$2"
      }
    fi
  done
fi
