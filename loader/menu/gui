# Historical m-loader theme initializer, used by the external loader.
# The GUI remains independent; selected historical ISO recipes are now exposed by the media index.
export gfxmode
export theme
export theme_name
export current_theme_dir
export m_loader_gui

set m_loader_gui=console
set theme=""

if [ -z "$theme_name" ]
then
  set theme_name=default
fi

if [ -z "$gfxmode" ]
then
  set gfxmode=1920x1080,1920x1200,1600x1050,1600x1200,1280x720,1280x800,1024x768,800x600x24,640x480
fi

set current_theme_dir="$theme_dir/$theme_name"

# Fonts must be loaded before switching to gfxterm.
if [ -f "$current_theme_dir/fonts.cfg" ]
then
  source "$current_theme_dir/fonts.cfg"
fi

# Video and GUI modules are dynamically loaded from the selected loader prefix.
if [ "$grub_platform" = efi ]
then
  insmod efi_gop
else
  insmod vbe
fi

# GRUB's built-in console remains the safe fallback for any graphics failure.
if insmod gfxterm
then
  if terminal_output gfxterm
  then
    set m_loader_gui=gfxterm
    if [ -f "$current_theme_dir/theme.cfg" ]
    then
      if insmod gfxmenu
      then
        insmod png
        insmod jpeg
        insmod tga
        set theme="$current_theme_dir/theme.cfg"
        set m_loader_gui=theme
      else
        echo "m-loader: gfxmenu unavailable; using unthemed graphics menu."
      fi
    else
      echo "m-loader: theme unavailable at $current_theme_dir; using unthemed graphics menu."
    fi
  else
    terminal_output console
    echo "m-loader: gfxterm unavailable; using GRUB console."
  fi
else
  terminal_output console
  echo "m-loader: graphics modules unavailable; using GRUB console."
fi

# Source succeeds even if only a console is available.
set m_loader_gui="$m_loader_gui"
