# Shared GRUB ISO inspection/boot operations used by the categorized ESP menu.
# The source ISO remains on MBOOTDATA; GRUB loopback does NOT create an OS CD.
function boot_media_iso_open {
  set boot_media_iso_previous_root="$root"
  set iso_path="$1"
  export iso_path
  if search --no-floppy --file --set=root "$iso_path"
  then
    if loopback loop "$iso_path"
    then
      return 0
    fi
    echo "GRUB cannot open the ISO as loopback: $iso_path"
  else
    echo "ISO not found: $iso_path"
  fi
  set root="$boot_media_iso_previous_root"
  return 1
}

function boot_media_iso_close {
  loopback --delete loop
  set root="$boot_media_iso_previous_root"
}

function boot_media_iso_grub {
  if boot_media_iso_open "$1"
  then
    if [ -f "(loop)/boot/grub/loopback.cfg" ]
    then
      set root=loop
      configfile /boot/grub/loopback.cfg
    else
      if [ -f "(loop)/boot/grub/grub.cfg" ]
      then
        echo "Experimental: ISO grub.cfg may assume real CD/USB media."
        # Native optical-media grub.cfg often resolves sub-configurations
        # through $prefix, so scope it to the mounted ISO while reading it.
        # Keep the loopback.cfg path above unchanged for working Ubuntu.
        set boot_media_iso_saved_prefix="$prefix"
        set root=loop
        set prefix="(loop)/boot/grub"
        configfile /boot/grub/grub.cfg
        set prefix="$boot_media_iso_saved_prefix"
      else
        echo "No GRUB loopback.cfg or grub.cfg found inside ISO."
        echo "This image needs a boot-specific recipe or virtual CD."
        sleep --interruptible 30
      fi
    fi
    boot_media_iso_close
  else
    sleep --interruptible 30
  fi
}

function boot_media_iso_efi {
  if [ "$grub_platform" != efi ]
  then
    echo "EFI chainloading requires UEFI."
    sleep --interruptible 30
    return 1
  fi
  if boot_media_iso_open "$1"
  then
    # ISO9660 path matching can be case-sensitive. The real physical
    # inventory includes several case variants across Ubuntu, Grml,
    # Proxmox, TrueNAS and HBCD PE: use paths proven to occur.
    set efi_image=""
    if [ "$grub_cpu" = arm64 ]
    then
      for efi_candidate in \
        "(loop)/EFI/BOOT/BOOTAA64.EFI" \
        "(loop)/EFI/BOOT/bootaa64.efi" \
        "(loop)/EFI/boot/bootaa64.efi" \
        "(loop)/efi/boot/bootaa64.efi"
      do
        if [ -f "$efi_candidate" ]
        then
          set efi_image="$efi_candidate"
          break
        fi
      done
    else
      if [ "$grub_cpu" = x86_64 ]
      then
        for efi_candidate in \
          "(loop)/EFI/BOOT/BOOTX64.EFI" \
          "(loop)/EFI/BOOT/BOOTx64.EFI" \
          "(loop)/EFI/BOOT/bootx64.efi" \
          "(loop)/EFI/boot/bootx64.efi" \
          "(loop)/efi/boot/bootx64.efi"
        do
          if [ -f "$efi_candidate" ]
          then
            set efi_image="$efi_candidate"
            break
          fi
        done
      fi
    fi
    if [ -n "$efi_image" ]
    then
      echo "Experimental: chainloading $efi_image from ISO loopback."
      echo "This does not emulate optical media for the OS or firmware."
      if chainloader "$efi_image"
      then
        boot
      else
        echo "GRUB could not chainload $efi_image."
        sleep --interruptible 30
      fi
    else
      echo "No matching EFI fallback file found for CPU $grub_cpu."
      echo "Verified candidate locations: EFI/BOOT and efi/boot."
      sleep --interruptible 30
    fi
    boot_media_iso_close
  else
    sleep --interruptible 30
  fi
}

function boot_media_iso_inspect {
  if boot_media_iso_open "$1"
  then
    echo "ISO contents: $iso_path"
    ls (loop)/
    if [ -d "(loop)/boot/grub" ]
    then
      echo "GRUB directory:"
      ls (loop)/boot/grub/
    fi
    if [ -d "(loop)/EFI/BOOT" ]
    then
      echo "EFI fallback directory:"
      ls (loop)/EFI/BOOT/
    fi
    boot_media_iso_close
  fi
  echo "Press Escape to return to the menu."
  sleep --interruptible 60
}

# Common experimental ISO submenu: exposes real attempts plus inspection.
# A visible ISO entry is not a claim that the operating system can mount it.
function boot_media_iso_experimental {
  submenu "$1 (experimental) ->" "$2" {
    set selected_iso="$2"
    export selected_iso
    menuentry "Try ISO GRUB configuration" {
      boot_media_iso_grub "$selected_iso"
    }
    if [ "$grub_platform" = efi ]
    then
      menuentry "Try embedded EFI application" {
        boot_media_iso_efi "$selected_iso"
      }
    fi
    menuentry "Inspect ISO files and boot paths" {
      boot_media_iso_inspect "$selected_iso"
    }
  }
}

