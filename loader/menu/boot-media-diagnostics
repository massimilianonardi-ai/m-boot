# Memtest86+ 9.00 provides bootable kernels separately from its ISO.
# Official upstream GRUB examples load the native binary as a Linux kernel,
# without initrd. The ISO is not a substitute for a native Memtest binary.
# Files are supplied by the operator under MBOOTDATA/m/boot/efi/memtest.

if [ "$grub_cpu" = arm64 ]
then
  # ARM64 Memtest86+ is UEFI-only. The unpacked binary is a PE/COFF EFI
  # application even when its published filename has no .efi extension.
  if [ "$grub_platform" = efi ]
  then
    for image in "$efipath"/memtest/mt86p_900_arm64
    do
      if [ -f "$image" ]
      then
        menuentry "Memtest86+ 9.00 ARM64 (UEFI binary)" "$image" {
          chainloader "$2"
          boot
        }
      fi
    done
  fi
else
  # Direct GRUB Linux-protocol entry for the x86_64 native binary.
  for image in "$efipath"/memtest/mt86p_900_x86_64
  do
    if [ -f "$image" ]
    then
      menuentry "Memtest86+ 9.00 x86_64 (native GRUB kernel)" "$image" {
        linux "$2"
      }
      if [ "$grub_platform" = pc ]
      then
        menuentry "Memtest86+ 9.00 x86_64 (legacy linux16 fallback)" "$image" {
          linux16 "$2"
        }
      fi
    fi
  done

  # The i586 binary is for legacy x86 BIOS, not x86_64 UEFI.
  if [ "$grub_platform" = pc ]
  then
    for image in "$efipath"/memtest/mt86p_900_i586
    do
      if [ -f "$image" ]
      then
        menuentry "Memtest86+ 9.00 i586 (legacy BIOS)" "$image" {
          linux16 "$2"
        }
      fi
    done
  fi

  # Retain the verified ISO as a read-only inspection / diagnostic path,
  # but do not imply that generic ISO loopback can execute a Memtest kernel.
  for image in "$isopath"/memtest86plus_*x86_64.iso
  do
    if [ -f "$image" ]
    then
      menuentry "Inspect Memtest86+ ISO (not a direct ISO boot)" "$image" {
        boot_media_iso_inspect "$2"
      }
    fi
  done
fi
