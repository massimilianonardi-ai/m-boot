# Memtest86+ v9 image: try the ISO's own GRUB / EFI loader. The ISO
# name alone does not determine its embedded BIOS/UEFI binary layout.
for image in "$isopath"/memtest86plus_*.iso
do
  if [ -f "$image" ]
  then
    boot_media_iso_experimental "$image" "$image"
  fi
done

# Unpacked architecture-specific Memtest86+ binaries, if the operator
# also copied them under MBOOTDATA/m/boot/efi/memtest.
if [ "$grub_platform" = efi ]
then
  for image in "$efipath"/memtest/mt86p_900_*.efi \
    "$efipath"/memtest/memtest*.efi
  do
    if [ -f "$image" ]
    then
      menuentry "$image (UEFI chainload, experimental)" "$image" {
        chainloader "$2"
        boot
      }
    fi
  done
fi
