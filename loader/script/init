
export root
export prefix

export init_disk
export boot_disk

export m_loader_disk
export m_loader_dir
export m_loader_init

set root="memdisk"
set prefix="($root)"

set init_disk="$root"
set m_loader_recovery="($init_disk)/recovery"

set boot_disk=""

set m_loader_disk=""
set m_loader_dir="/m/boot/loader"
set m_loader_init="$m_loader_dir/init"

if [ -n "$cmdpath" ]
then
  if regexp --set boot_disk '^\(([^)]*)\)' "$cmdpath"
  then
    echo "m-boot: using firmware boot device ($boot_disk)"
  else
    echo "m-boot: using cmdpath=$cmdpath detected boot device=($boot_disk) returned error"
  fi
fi

if [ -n "$boot_disk" ] && [ -f "($boot_disk)$m_loader_init" ]
then
  set m_loader_disk="$boot_disk"
else
  echo "m-boot: m-loader not found on firmware boot device, searching all devices..."
  if search --no-floppy --file --set m_loader_disk "$m_loader_init"
  then
    echo "m-boot: found m-loader on disk=($m_loader_disk), path='$m_loader_init'"
  else
    echo "m-boot: m-loader cannot be found."
    set m_loader_disk=""
  fi
fi

if [ -n "$m_loader_disk" ] && [ -f "($m_loader_disk)$m_loader_init" ]
then
  set root="$m_loader_disk"
  echo "m-boot: executing m-loader on disk=($m_loader_disk), path='$m_loader_init'"
  if ! source "$m_loader_init"
  then
    echo "m-boot: m-loader execution error, executing recovery..."
    set root="$init_disk"
    source "$m_loader_recovery"
  fi
else
  echo "m-boot: no m-loader found, executing recovery..."
  source "$m_loader_recovery"
fi
