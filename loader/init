# Temporary smoke test for boot/init -> external /m/boot/loader/init.
# This is not the multiboot loader.

set default=0
set timeout=-1

echo "m-loader test: external init reached at ($root)$m_loader_init"

menuentry "m-loader TEST: inspect boot context" --hotkey=i {
  echo "m-loader test: external init executed"
  echo "cmdpath=$cmdpath"
  echo "root=$root"
  echo "prefix=$prefix"
  echo "m_loader_disk=$m_loader_disk"
  echo "m_loader_init=$m_loader_init"
  echo "GRUB devices:"
  ls
  echo "Loader directory:"
  ls "$m_loader_dir/"
  echo "Press Escape to return to the menu."
  sleep --interruptible 60
}

menuentry "Embedded recovery" --hotkey=r {
  configfile "(memdisk)/recovery"
}

menuentry "Reboot" --hotkey=b {
  reboot
}

menuentry "Shut down" --hotkey=s {
  halt
}
